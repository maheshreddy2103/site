# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/savenbuy?retryWrites=true&w=majority
# Local Example: mongodb://localhost:27017/savenbuy
DATABASE_URL="mongodb://localhost:27017/savenbuy"
MONGODB_URI="mongodb://localhost:27017/savenbuy"

# JWT Secret for Session & Cryptographic Tokens
JWT_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_SECRET="your-next-auth-secret-change-in-production"

# Server Port
PORT=5000
